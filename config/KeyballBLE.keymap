#define ZMK_POINTING_DEFAULT_SCRL_VAL 120 // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

// ============================================================
//  JIS(日本語配列)設定のPC で正しい記号を出すための変換定義
//  左が「出したい文字」、右が「送るべきUS配列上のキー」
// ============================================================
#define JP_HANZEN     GRAVE              // 半角/全角
#define JP_UNDERSCORE LS(0x87)           // _
#define JP_QUOTE      AMPERSAND          // '
#define JP_DQUOTE     AT                 // "
#define JP_AMPERSAND  CARET              // &
#define JP_AT         LEFT_BRACKET       // @
#define JP_COLON      SINGLE_QUOTE       // :
#define JP_PLUS       COLON              // +
#define JP_ASTERISK   DOUBLE_QUOTES      // *
#define JP_CARET      EQUAL              // ^
#define JP_EQUAL      UNDERSCORE         // =
#define JP_TILDE      PLUS               // ~
#define JP_YEN        0x89               // \ (¥)
#define JP_PIPE       LS(0x89)           // |
#define JP_LBRACKET   RIGHT_BRACKET      // [
#define JP_RBRACKET   BACKSLASH          // ]
#define JP_LBRACE     RIGHT_BRACE        // {
#define JP_RBRACE     PIPE               // }
#define JP_LPAREN     ASTERISK           // (
#define JP_RPAREN     LEFT_PARENTHESIS   // )
#define JP_BACKQUOTE  LEFT_BRACE         // `

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            slow-release;
            timeout-ms = <300>;
            layers = <0 7>;
        };

        ctrl {
            bindings = <&kp LCTRL>;
            key-positions = <8 9>;
            slow-release;
            timeout-ms = <300>;
            layers = <0>;
        };

        // Windows時のみ: O+P で 範囲選択スクリーンショット
        win_snip {
            bindings = <&kp LG(LS(S))>;
            key-positions = <8 9>;
            timeout-ms = <150>;
            layers = <7>;
        };

        caps {
            bindings = <&kp CLCK>;
            key-positions = <3 4>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        to_layer_7: to_layer_7 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 7 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_7";
        };

        DIST_00input: DIST_00input {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_0 &kp NUMBER_0>;
            label = "DIST_00INPUT";
        };

        // BT切替と同時に、その機器用のベースレイヤーへ移動する
        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 7>;
            label = "BT_WIN";
        };

        bt_mac1: bt_mac1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 0>;
            label = "BT_MAC1";
        };

        bt_mac2: bt_mac2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to 0>;
            label = "BT_MAC2";
        };

        bt_mac3: bt_mac3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &to 0>;
            label = "BT_MAC3";
        };

        bt_mac4: bt_mac4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &to 0>;
            label = "BT_MAC4";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lt_to_layer_7: lt_to_layer_7 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_7";
            bindings = <&mo>, <&to_layer_7>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ============ 0: Mac / iPad / iPhone ベース ============
        default_layer {
            bindings = <
&kp Q            &kp W         &kp E              &kp R                       &kp T                         &kp Y        &kp U      &kp I      &kp O        &kp P
&kp A            &kp S         &kp D              &kp F                       &kp G   &mkp LCLK   &kp DELETE     &kp H        &kp J      &kp K      &kp L        &kp SEMI
&lt 5 Z          &kp X         &kp C              &kp V                       &kp B   &mt NUMBER_4 NUMBER_3   &lt 1 MINUS    &kp N        &kp M      &kp COMMA  &kp DOT      &lt 5 SINGLE_QUOTE
&mt LEFT_SHIFT TAB   &kp LEFT_ALT   &kp LEFT_COMMAND   &lt_to_layer_0 3 CAPSLOCK   &kp SPACE   &kp ENTER   &kp ENTER      &kp BACKSPACE   &lt 6 SLASH
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        // ============ 1: Mac用 テンキー+ファンクション ============
        // 数字を通常キーに変更（IMEの変換窓に入るので 123097 → 123,097 が可能）
        Num_FUNCTION {
            bindings = <
&kp NUMBER_7   &kp NUMBER_8   &kp NUMBER_9   &kp PERCENT   &kp SLASH        &trans   &trans   &kp UP_ARROW   &trans   &trans
&kp NUMBER_4   &kp NUMBER_5   &kp NUMBER_6   &kp ASTRK     &kp KP_MINUS   &trans   &kp DELETE   &trans   &kp LEFT   &kp DOWN   &kp RIGHT   &trans
&kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3   &kp PLUS      &kp KP_EQUAL   &kp BACKSPACE   &trans   &trans   &trans   &trans   &trans   &trans
&kp NUMBER_0   &DIST_00input  &kp DOT        &kp COLON     &kp SPACE   &kp ENTER   &kp ENTER   &kp BACKSPACE   &trans
            >;
        };

        // ============ 2: Mac用 記号 ============
        NUM {
            bindings = <
&kp MINUS   &kp NUMBER_7   &kp NUMBER_8   &kp NUMBER_9   &kp PLUS       &kp CARET   &kp AMPERSAND   &kp TILDE   &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS
&kp SLASH   &kp NUMBER_4   &kp NUMBER_5   &kp NUMBER_6   &kp ASTERISK   &kp LC(LA(KP_NUMBER_0))   &kp A   &kp EXCLAMATION   &kp AT_SIGN   &kp HASH   &kp DOLLAR   &kp PERCENT
&mt LEFT_SHIFT NUMBER_0   &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3   &kp PERIOD   &kp EQUAL   &trans   &kp LEFT_BRACKET   &kp RIGHT_BRACKET   &kp LEFT_BRACE   &kp RIGHT_BRACE   &kp BACKSLASH
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &kp PIPE
            >;
        };

        // ============ 3: 矢印・Fキー (Mac/Windows 共用) ============
        YAJIRUSHI {
            bindings = <
&kp F1    &kp F2    &kp F3   &kp F4   &kp F5     &kp ESC   &trans   &kp UP     &kp PRINTSCREEN   &kp HOME
&kp F6    &kp F7    &kp F8   &kp F9   &kp F10    &kp F11   &trans   &trans     &kp LEFT   &kp DOWN   &kp RIGHT   &kp END
&kp F12   &kp F13   &trans   &trans   &trans     &trans    &trans   &trans     &trans   &trans   &trans   &kp PG_UP
&trans    &trans    &trans   &trans   &trans     &trans    &trans   &trans     &kp PG_DN
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        // ============ 4: マウス (Mac/Windows 共用) ============
        // ⌘/Ctrl の位置は &trans にして、接続先に応じて自動で変わるようにした
        MOUSE {
            bindings = <
&trans     &trans      &trans      &trans      &trans      &trans      &trans   &trans   &trans   &trans
&mkp MB4   &mkp LCLK   &mkp MCLK   &mkp RCLK   &mkp MB5    &mkp LCLK   &trans   &mkp MB4   &mkp LCLK   &mkp MCLK   &mkp RCLK   &mkp MB5
&trans     &trans      &trans      &trans      &trans      &mkp RCLK   &trans   &trans   &trans   &trans   &trans   &trans
&kp LEFT_SHIFT   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;
        };

        // ============ 5: Mac用 記号 (HIROKI) ============
        HIROKI {
            bindings = <
&kp TILDE   &kp EXCLAMATION   &kp AT_SIGN   &kp HASH   &kp PERCENT   &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS   &kp KP_EQUAL   &kp KP_MINUS   &kp PLUS
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &kp ASTRK   &kp COLON
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &kp LEFT_BRACKET   &kp RIGHT_BRACKET   &kp DOUBLE_QUOTES
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &kp QMARK
            >;
        };

        // ============ 6: Bluetooth切替 ============
        // BT_SEL を押すと、その機器用のベースレイヤーへ自動で移動する
        // 危険キーは端に移動。&bootloader は削除（物理リセットボタンで代用）
        layer_6 {
            bindings = <
&trans   &trans   &trans   &trans   &trans     &bt_win   &bt_mac1   &bt_mac2   &bt_mac3   &bt_mac4
&trans   &trans   &trans   &trans   &trans   &trans     &studio_unlock   &trans   &trans   &trans   &trans   &bt BT_CLR
&trans   &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3   &kt KP_N4   &trans     &trans   &trans   &trans   &trans   &trans   &bt BT_CLR_ALL
&trans   &trans   &trans   &trans   &trans     &trans   &trans   &trans   &trans
            >;
        };

        // ============ 7: Windows(JIS) ベース ============
        // ⌘の位置 → Ctrl / Bの右隣 → Windowsキー
        // CAPSキー単押し → 半角/全角 / 左親指の重複ENTER → 無変換
        WIN_BASE {
            bindings = <
&kp Q            &kp W         &kp E              &kp R                        &kp T                      &kp Y        &kp U      &kp I      &kp O        &kp P
&kp A            &kp S         &kp D              &kp F                        &kp G   &mkp LCLK   &kp DELETE    &kp H        &kp J      &kp K      &kp L        &kp SEMI
&lt 10 Z         &kp X         &kp C              &kp V                        &kp B   &kp LEFT_GUI   &lt 8 MINUS   &kp N        &kp M      &kp COMMA  &kp DOT      &lt 10 JP_QUOTE
&mt LEFT_SHIFT TAB   &kp LEFT_ALT   &kp LEFT_CONTROL   &lt_to_layer_7 3 JP_HANZEN   &kp SPACE   &kp INT5   &kp ENTER     &kp BACKSPACE   &lt 6 SLASH
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        // ============ 8: Windows(JIS) テンキー+ファンクション ============
        // 変換(INT4)/無変換(INT5) を予備として配置
        WIN_NUMFUNC {
            bindings = <
&kp NUMBER_7   &kp NUMBER_8   &kp NUMBER_9   &kp PERCENT        &kp SLASH        &trans   &trans   &kp UP_ARROW   &trans   &trans
&kp NUMBER_4   &kp NUMBER_5   &kp NUMBER_6   &kp JP_ASTERISK    &kp KP_MINUS   &trans   &kp DELETE   &trans   &kp LEFT   &kp DOWN   &kp RIGHT   &trans
&kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3   &kp JP_PLUS        &kp KP_EQUAL   &kp BACKSPACE   &trans   &kp INT4   &kp INT5   &trans   &trans   &trans
&kp NUMBER_0   &DIST_00input  &kp DOT        &kp JP_COLON       &kp SPACE   &kp ENTER   &kp ENTER   &kp BACKSPACE   &trans
            >;
        };

        // ============ 9: Windows(JIS) 記号 ============
        WIN_NUM {
            bindings = <
&kp MINUS   &kp NUMBER_7   &kp NUMBER_8   &kp NUMBER_9   &kp JP_PLUS        &kp JP_CARET   &kp JP_AMPERSAND   &kp JP_TILDE   &kp JP_LPAREN   &kp JP_RPAREN
&kp SLASH   &kp NUMBER_4   &kp NUMBER_5   &kp NUMBER_6   &kp JP_ASTERISK    &kp LC(LA(KP_NUMBER_0))   &kp A   &kp EXCLAMATION   &kp JP_AT   &kp HASH   &kp DOLLAR   &kp PERCENT
&mt LEFT_SHIFT NUMBER_0   &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3   &kp PERIOD   &kp JP_EQUAL   &trans   &kp JP_LBRACKET   &kp JP_RBRACKET   &kp JP_LBRACE   &kp JP_RBRACE   &kp JP_YEN
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &kp JP_PIPE
            >;
        };

        // ============ 10: Windows(JIS) 記号 (HIROKI) ============
        // アンダースコア「_」を H の位置に配置
        WIN_HIROKI {
            bindings = <
&kp JP_TILDE   &kp EXCLAMATION   &kp JP_AT   &kp HASH   &kp PERCENT   &kp JP_LPAREN   &kp JP_RPAREN   &kp KP_EQUAL   &kp KP_MINUS   &kp JP_PLUS
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &kp JP_UNDERSCORE   &trans   &trans   &kp JP_ASTERISK   &kp JP_COLON
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &kp JP_LBRACKET   &kp JP_RBRACKET   &kp JP_DQUOTE
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &kp QMARK
            >;
        };
    };
};
